# Copy this file to .env.local and fill in the real values.
# Never commit .env.local — it holds secrets.

# --- Supabase (free Postgres database) ---
# Project Settings -> API in your Supabase dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- AI provider ---
# Which provider to use. Supported: "groq" | "gemini"
AI_PROVIDER=groq

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
# Groq retires/renames models sometimes. If you get a "model_not_found"
# error, list what's actually available to your key with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer YOUR_KEY"
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (https://aistudio.google.com/apikey) - only needed if AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Admin page (this is YOU, the app owner) ---
ADMIN_PASSWORD=choose-a-strong-password

# Used to sign the admin login cookie. Any long random string is fine.
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# Base URL of your deployed app (used to build embed snippets). For local dev:
NEXT_PUBLIC_BASE_URL=http://localhost:3000
